VITE_SUPABASE_URL=

# Robinhood Chain testnet (46630) - deployed 2026-09-07
VITE_KEY_REGISTRY_ADDRESS=
VITE_MESSAGE_ANCHOR_ADDRESS=

# Legacy relayer. Nothing writes anchors from this key any more -- senders sign
# their own. Kept only so verification still resolves for mail anchored under
# the old Solana-era arrangement, where msg.sender was xmail rather than the
# sender. Leave unset for a fresh deployment.
VITE_ANCHOR_RELAYER=
