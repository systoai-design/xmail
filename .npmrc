# @solana/wallet-adapter-react pulls in @solana-mobile/mobile-wallet-adapter-protocol,
# whose react-native peer chain demands @types/react@19 while this project is on
# React 18. The graph is genuinely unresolvable, so installs have always needed
# this flag -- committing it means CI, Vercel and local all resolve identically
# instead of only working for whoever remembers to pass it.
legacy-peer-deps=true
